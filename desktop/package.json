{
  "name": "square-desktop",
  "productName": "Shiqi",
  "version": "1.0.1",
  "description": "Shiqi. — aplicativo para computador",
  "main": "main.js",
  "author": "Shiqi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.square.desktop",
    "productName": "Shiqi",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "picker.html", "picker-preload.js", "offline.html", "build/tray.png", "build/icon.png"],
    "publish": [{ "provider": "github", "owner": "steamconnectalex-collab", "repo": "shiqi-downloads", "releaseType": "release" }],
    "win": { "icon": "build/icon.png", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "artifactName": "Shiqi-Setup.exe", "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "appImage": { "artifactName": "Shiqi.AppImage" },
    "linux": { "icon": "build/icon.png", "target": ["AppImage"], "category": "Network", "maintainer": "Shiqi" }
  }
}
